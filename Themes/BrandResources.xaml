<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Couleurs Melody par défaut (vert dégradé — remplacées par l'entreprise si configurées) -->
    <Color x:Key="BrandPrimaryColor">#FF047857</Color>
    <Color x:Key="BrandPrimaryDarkColor">#FF065F46</Color>
    <Color x:Key="BrandPrimaryLightColor">#FF10B981</Color>
    <Color x:Key="BrandSecondaryColor">#FF34D399</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}"/>
    <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="{StaticResource BrandPrimaryDarkColor}"/>
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{StaticResource BrandSecondaryColor}"/>
    <SolidColorBrush x:Key="BrandOnPrimaryBrush" Color="White"/>
    <SolidColorBrush x:Key="BrandSelectedBorderBrush" Color="{StaticResource BrandSecondaryColor}"/>

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource BrandPrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource BrandSecondaryColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Barre latérale principale -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#FF152238"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FF2D4568"/>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource BrandPrimaryColor}"/>
    <SolidColorBrush x:Key="SidebarAccentBrush" Color="{StaticResource BrandSecondaryColor}"/>
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#FF8BA3C4"/>

    <!-- Boutons Material Design aux couleurs entreprise -->
    <Style x:Key="BrandRaisedButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
    </Style>

    <Style x:Key="BrandRaisedSecondaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{DynamicResource BrandSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrandSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
    </Style>

    <Style x:Key="BrandHeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="BrandHeaderBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
        <Setter Property="Padding" Value="20,18"/>
    </Style>

    <Style x:Key="PageHeroBannerStyle" TargetType="Border">
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="Background" Value="{DynamicResource BrandGradientBrush}"/>
    </Style>

    <Style x:Key="PageActionsBarStyle" TargetType="Border">
        <Setter Property="Background" Value="#ECFDF5"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="#A7F3D0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style x:Key="MelodyFormCardStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="MelodyFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#546E7A"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="MelodyDataGridHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="#065F46"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style x:Key="MelodyDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#A7F3D0"/>
                <Setter Property="Foreground" Value="#065F46"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="#6EE7B7"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
