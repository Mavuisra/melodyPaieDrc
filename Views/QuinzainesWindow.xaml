<Window x:Class="MelodyPaieRDC.Views.QuinzainesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:MelodyPaieRDC.Helpers"
        Title="Octrois de quinzaine"
        Height="560" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Window.Resources>
        <helpers:StringToDecimalConverter x:Key="StringToDecimalConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Octrois de quinzaine" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Les octrois sont enregistrés puis reportés automatiquement dans les acomptes de la saisie de paie."
                       FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Période" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Periodes}" SelectedItem="{Binding Periode, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Mois}"/>
                                    <Run Text="/"/>
                                    <Run Text="{Binding Annee}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Employé" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Employes}" SelectedItem="{Binding Employe, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Matricule}" FontWeight="SemiBold"/>
                                    <Run Text=" — "/>
                                    <Run Text="{Binding Nom}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Prenom}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Date d'octroi" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding DateOctroi, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Montant" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Montant, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringToDecimalConverter}}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" Margin="0,12,0,0">
                    <TextBlock Text="Commentaire (optionnel)" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Commentaire, UpdateSourceTrigger=PropertyChanged}" MaxLength="255"/>
                </StackPanel>
            </Grid>
        </Border>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Octrois}" SelectedItem="{Binding Selectionne, Mode=TwoWay}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding DateOctroi, StringFormat=dd/MM/yyyy}" Width="100"/>
                <DataGridTextColumn Header="Matricule" Binding="{Binding Employe.Matricule}" Width="90"/>
                <DataGridTextColumn Header="Employé" Binding="{Binding Employe.Nom}" Width="*"/>
                <DataGridTextColumn Header="Montant" Binding="{Binding Montant, StringFormat=N2}" Width="110"/>
                <DataGridTextColumn Header="Commentaire" Binding="{Binding Commentaire}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Command="{Binding AjouterCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8" Margin="0,0,8,0"
                    IsEnabled="{Binding PeutModifier}">
                <TextBlock Text="Créer l'octroi"/>
            </Button>
            <Button Command="{Binding EnregistrerCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8" Margin="0,0,8,0">
                <TextBlock Text="Modifier la sélection"/>
            </Button>
            <Button Command="{Binding SupprimerCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8" Margin="0,0,8,0">
                <TextBlock Text="Supprimer"/>
            </Button>
            <Button Command="{Binding ExporterPdfCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                <TextBlock Text="Exporter PDF"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
