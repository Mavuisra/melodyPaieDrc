                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ClipboardList" Width="20" Height="20" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Bulletins de la période" FontWeight="SemiBold" FontSize="14" Foreground="#004D40" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding BulletinsPeriode}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#ECEFF1"
                                              Background="Transparent"
                                              RowBackground="White"
                                              AlternatingRowBackground="#FAFAFC"
                                              BorderThickness="0"
                                              RowHeight="38">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Padding" Value="12,10"/>
                                                <Setter Property="BorderBrush" Value="#C8E6C9"/>
                                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="N° bulletin" Binding="{Binding NumeroBulletin}" Width="105"/>
                                            <DataGridTextColumn Header="Matricule" Binding="{Binding Employe.Matricule}" Width="90"/>
                                            <DataGridTextColumn Header="Employé" Width="*">
                                                <DataGridTextColumn.Binding>
                                                    <MultiBinding StringFormat="{}{0} {1} {2}">
                                                        <Binding Path="Employe.Nom"/>
                                                        <Binding Path="Employe.Postnom"/>
                                                        <Binding Path="Employe.Prenom"/>
                                                    </MultiBinding>
                                                </DataGridTextColumn.Binding>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Net à payer" Binding="{Binding NetAPayer, StringFormat=N2}" Width="105"/>
                                            <DataGridTextColumn Header="IPR net" Binding="{Binding MontantIprNet, StringFormat=N2}" Width="95"/>
                                            <DataGridTextColumn Header="CNSS ouvrier" Binding="{Binding CotisationCnssOuvrier, StringFormat=N2}" Width="105"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Rapport de paie (menu 8) -->
                <Border Grid.Row="4" CornerRadius="14" Padding="0" ClipToBounds="True"
                        BorderBrush="#E2E8F0" BorderThickness="1"
                        Visibility="{Binding MenuSelectionne, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=8}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F3F8FC" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="20,16">
                            <Border.Background>
                                <DynamicResource ResourceKey="BrandGradientBrush"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="44" Height="44" CornerRadius="12" Background="#30FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FileChart" Width="26" Height="26" Foreground="White"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Rapport de paie" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Synthèse des bulletins par période — consultation, PDF et export Excel."
                                                   FontSize="12" Foreground="#D1FAE5" TextWrapping="Wrap" MaxWidth="520" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#25FFFFFF" CornerRadius="10" Padding="12,8" VerticalAlignment="Center" BorderBrush="#40FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Période" FontSize="10" Foreground="#D1FAE5"/>
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:D2} / {1}">
                                                    <Binding Path="PeriodeSelectionneePourRapport.Mois" FallbackValue="—"/>
                                                    <Binding Path="PeriodeSelectionneePourRapport.Annee" FallbackValue=""/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="20,16,20,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="White" CornerRadius="12" Padding="16,14" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="CalendarMonth" Width="18" Height="18" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Période" FontWeight="SemiBold" FontSize="13" Foreground="#37474F" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding PeriodesPaie}"
                                                  SelectedItem="{Binding PeriodeSelectionneePourRapport, Mode=TwoWay}"
                                                  IsEditable="False">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding Mois}"/>
                                                        <Run Text="/"/>
                                                        <Run Text="{Binding Annee}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Margin="16,0,0,0" Background="White" CornerRadius="12" Padding="14,12" BorderBrush="#A7F3D0" BorderThickness="1" VerticalAlignment="Stretch">
                                    <DockPanel LastChildFill="True">
                                        <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Filter" Width="20" Height="20" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Filtrer les bulletins" FontSize="12" Foreground="#607D8B" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding FiltreRapportPaie, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Matricule, nom, département, n° bulletin…"
                                                     Padding="10,8"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,14">
                                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,4,0" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="Receipt" Width="24" Height="24" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Bulletins" FontSize="11" Foreground="#78909C"/>
                                        <TextBlock Text="{Binding RapportPaieNbBulletins, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="2,0,2,0" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="CurrencyUsd" Width="24" Height="24" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Salaire brut" FontSize="11" Foreground="#78909C"/>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrandPrimaryBrush}">
                                            <Run Text="{Binding RapportPaieTotalBrut, StringFormat=N0, Mode=OneWay}"/><Run Text=" USD" FontSize="11"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="2,0,2,0" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="CashMultiple" Width="24" Height="24" Foreground="#2E7D32" Margin="0,0,0,8"/>
                                        <TextBlock Text="Net à payer" FontSize="11" Foreground="#78909C"/>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1B5E20">
                                            <Run Text="{Binding RapportPaieTotalNet, StringFormat=N0, Mode=OneWay}"/><Run Text=" USD" FontSize="11"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="2,0,2,0" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="Receipt" Width="24" Height="24" Foreground="#E65100" Margin="0,0,0,8"/>
                                        <TextBlock Text="IPR total" FontSize="11" Foreground="#78909C"/>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#BF360C">
                                            <Run Text="{Binding RapportPaieTotalIpr, StringFormat=N0, Mode=OneWay}"/><Run Text=" USD" FontSize="11"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="4,0,0,0" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="Shield" Width="24" Height="24" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="CNSS ouvrier" FontSize="11" Foreground="#78909C"/>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#065F46">
                                            <Run Text="{Binding RapportPaieTotalCnss, StringFormat=N0, Mode=OneWay}"/><Run Text=" USD" FontSize="11"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="2" Background="#ECFDF5" CornerRadius="12" BorderBrush="#A7F3D0" BorderThickness="1" Padding="12,10" Margin="0,0,0,14">
                                <WrapPanel Orientation="Horizontal">
                                    <Button Command="{Binding VoirRapportBulletinCommand}" Margin="0,4,8,4"
                                            Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Eye" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="Voir le bulletin" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding TelechargerRapportBulletinCommand}" Margin="0,4,8,4"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="Télécharger PDF (A5)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ExportRapportPaieExcelCommand}" Margin="0,4,0,4"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="MicrosoftExcel" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="Exporter Excel" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Border>

                            <Border Grid.Row="3" Background="White" CornerRadius="12" BorderBrush="#E4EAF2" BorderThickness="1" MinHeight="180" VerticalAlignment="Stretch">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="0,0,0,1" Padding="16,12">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ClipboardList" Width="20" Height="20" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Détail par bulletin" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding BulletinsRapportPaie}"
                                              SelectedItem="{Binding BulletinSelectionnePourRapport, Mode=TwoWay}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#ECEFF1"
                                              Background="Transparent"
                                              RowBackground="White"
                                              AlternatingRowBackground="#FAFAFC"
                                              BorderThickness="0"
                                              RowHeight="38"
                                              MaxHeight="560"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.CanContentScroll="True"
                                              EnableColumnVirtualization="True"
                                              SelectionMode="Single" SelectionUnit="FullRow">
                                        <DataGrid.ColumnHeaderStyle>
                                            <StaticResource ResourceKey="MelodyDataGridSubHeaderStyle"/>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="N° bulletin" Binding="{Binding NumeroBulletin}" Width="105"/>
                                            <DataGridTextColumn Header="Matricule" Binding="{Binding Employe.Matricule}" Width="90"/>
                                            <DataGridTextColumn Header="Employé" Width="*">
                                                <DataGridTextColumn.Binding>
                                                    <MultiBinding StringFormat="{}{0} {1} {2}">
                                                        <Binding Path="Employe.Nom"/>
                                                        <Binding Path="Employe.Postnom"/>
                                                        <Binding Path="Employe.Prenom"/>
                                                    </MultiBinding>
                                                </DataGridTextColumn.Binding>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Département" Binding="{Binding Employe.Departement.NomDepartement}" Width="120"/>
                                            <DataGridTextColumn Header="Brut" Binding="{Binding SalaireBrut, StringFormat=N2}" Width="100"/>
                                            <DataGridTextColumn Header="Net à payer" Binding="{Binding NetAPayer, StringFormat=N2}" Width="105"/>
                                            <DataGridTextColumn Header="IPR net" Binding="{Binding MontantIprNet, StringFormat=N2}" Width="95"/>
                                            <DataGridTextColumn Header="CNSS" Binding="{Binding CotisationCnssOuvrier, StringFormat=N2}" Width="90"/>
                                            <DataGridTextColumn Header="Généré le" Binding="{Binding DateGeneration, StringFormat=d}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Pointage (menu 1) — panneau autonome pleine hauteur -->
                <Border Grid.Row="4" Margin="0,0,0,8" VerticalAlignment="Stretch"
                        Visibility="{Binding MenuSelectionne, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=1}">
                    <views:SuiviJournalierPanel x:Name="PanneauSuiviJournalier" VerticalAlignment="Stretch" MinHeight="520"/>
                </Border>

                <!-- Totaux heures pour la paie (menu 2) -->
                <Border Grid.Row="4" Margin="0,0,0,8"
                        Visibility="{Binding MenuSelectionne, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=2}">
                    <views:HeuresPresteesTotauxPanel x:Name="PanneauHeuresPrestees"/>
                </Border>

                <!-- Bulletins générés (menu 7) -->
                <Border Grid.Row="4" CornerRadius="14" Padding="0" ClipToBounds="True"
                        BorderBrush="#E2E8F0" BorderThickness="1"
                        Visibility="{Binding MenuSelectionne, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=7}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#FFF8F5" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="20,16">
                            <Border.Background>
                                <DynamicResource ResourceKey="BrandGradientBrush"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="44" Height="44" CornerRadius="12" Background="#30FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Receipt" Width="26" Height="26" Foreground="White"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Bulletins générés" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Historique de tous les bulletins — recherche, consultation et export PDF."
                                                   FontSize="12" Foreground="#D1FAE5" TextWrapping="Wrap" MaxWidth="520" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#25FFFFFF" CornerRadius="10" Padding="12,8" VerticalAlignment="Center" BorderBrush="#40FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="En base" FontSize="10" Foreground="#D1FAE5"/>
                                        <TextBlock Text="{Binding BulletinsGeneresTotalCount, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="20,16,20,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="14,12" BorderBrush="#A7F3D0" BorderThickness="1" Margin="0,0,0,14">
                                <DockPanel LastChildFill="True">
                                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Filter" Width="20" Height="20" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Rechercher" FontSize="12" Foreground="#607D8B" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding FiltreBulletinsGeneres, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Matricule, nom, n° bulletin, période (MM/AAAA), département…"
                                                 Padding="10,8"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
                                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,6,0" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="Database" Width="24" Height="24" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Total bulletins" FontSize="11" Foreground="#78909C"/>
                                        <TextBlock Text="{Binding BulletinsGeneresTotalCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="#065F46"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="3,0,3,0" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="FormatListNumbered" Width="24" Height="24" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Lignes affichées" FontSize="11" Foreground="#78909C"/>
                                        <TextBlock Text="{Binding BulletinsGeneresAfficheCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="#065F46"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="6,0,0,0" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="CashMultiple" Width="24" Height="24" Foreground="#2E7D32" Margin="0,0,0,8"/>
