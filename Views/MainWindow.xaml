                                        IconKind="FormTextbox"
                                        OuvrirCommand="{Binding OuvrirChampsComplementairesEmployeCommand}"/>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileChartOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="Rapport" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <views:EmployeRapportPanel x:Name="PanneauEmployeRapport"/>
                                </TabItem>
                            </TabControl>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Calcul de paie (menu 4) -->
                <Border Grid.Row="4" CornerRadius="14" Padding="0" ClipToBounds="True"
                        BorderBrush="#E2E8F0" BorderThickness="1"
                        Visibility="{Binding MenuSelectionne, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=4}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F8FAFE" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.10"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Bandeau -->
                        <Border Grid.Row="0" Padding="20,16">
                            <Border.Background>
                                <DynamicResource ResourceKey="BrandGradientBrush"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="44" Height="44" CornerRadius="12" Background="#30FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Calculator" Width="26" Height="26" Foreground="White"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Calcul &amp; bulletins de paie" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Saisie mensuelle, génération des bulletins et export PDF pour la période choisie."
                                                   FontSize="12" Foreground="#D1FAE5" TextWrapping="Wrap" MaxWidth="520" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#25FFFFFF" CornerRadius="10" Padding="12,8" VerticalAlignment="Center" BorderBrush="#40FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Période active" FontSize="10" Foreground="#D1FAE5"/>
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:D2} / {1}">
                                                    <Binding Path="PeriodeSelectionneePourPaie.Mois" FallbackValue="—"/>
                                                    <Binding Path="PeriodeSelectionneePourPaie.Annee" FallbackValue=""/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="20,16,20,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Période + alerte clôture -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="White" CornerRadius="12" Padding="16,14" BorderBrush="#E4EAF2" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="CalendarMonth" Width="18" Height="18" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Période de paie" FontWeight="SemiBold" FontSize="13" Foreground="#37474F" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding PeriodesPaie}"
                                                  SelectedItem="{Binding PeriodeSelectionneePourPaie, Mode=TwoWay}"
                                                  IsEditable="False"
                                                  materialDesign:HintAssist.Hint="Mois / année">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding Mois}"/>
                                                        <Run Text="/"/>
                                                        <Run Text="{Binding Annee}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                        Background="#FFF3E0" CornerRadius="10" Padding="12,10" BorderBrush="#FFE0B2" BorderThickness="1"
                                        Visibility="{Binding PeriodePaieEstCloturee, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Lock" Width="20" Height="20" Foreground="#E65100" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cette période est clôturée : la génération de nouveaux bulletins est désactivée. Consultation et PDF restent possibles."
                                                   Foreground="#BF360C" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Actions -->
                            <Border Grid.Row="1" Background="#ECFDF5" CornerRadius="12" BorderBrush="#A7F3D0" BorderThickness="1" Padding="12,10" Margin="0,0,0,14">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Command="{Binding OuvrirSaisiePaieMoisCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="TableEdit" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="Saisie de paie (mois)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding OuvrirQuinzainesCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8"
                                                ToolTip="Créer, modifier ou exporter les octrois de quinzaine">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CashPlus" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="Quinzaines" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding GenererBulletinCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileDocumentMultiple" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="Générer les bulletins" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding VoirBulletinCalculPaieCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Eye" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="Voir le bulletin" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding TelechargerBulletinCalculPaieCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="PDF (A5)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExporterFeuilleBulletinsPeriodeCommand}" Margin="0,4,0,4"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8"
                                                ToolTip="Exporte tous les bulletins de la période — 2 fiches A5 par feuille A4">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileDocumentMultiple" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="Feuille A4 (2 bulletins)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- Liste bulletins -->
                            <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E4EAF2" BorderThickness="1" MinHeight="200" VerticalAlignment="Stretch">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="0,0,0,1" Padding="16,12">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Bulletins de la période" FontWeight="SemiBold" FontSize="14" Foreground="#065F46" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding BulletinsPeriodeCalculPaie}"
                                              SelectedItem="{Binding BulletinSelectionnePourCalculPaie, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#ECEFF1"
                                              Background="Transparent"
                                              RowBackground="White"
                                              AlternatingRowBackground="#FAFAFC"
                                              BorderThickness="0"
                                              RowHeight="38">
                                        <DataGrid.ColumnHeaderStyle>
                                            <StaticResource ResourceKey="MelodyDataGridSubHeaderStyle"/>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="N° bulletin" Binding="{Binding NumeroBulletin}" Width="110"/>
                                            <DataGridTextColumn Header="Matricule" Binding="{Binding Employe.Matricule}" Width="90"/>
                                            <DataGridTextColumn Header="Employé" Width="*">
                                                <DataGridTextColumn.Binding>
                                                    <MultiBinding StringFormat="{}{0} {1} {2}">
                                                        <Binding Path="Employe.Nom"/>
                                                        <Binding Path="Employe.Postnom"/>
                                                        <Binding Path="Employe.Prenom"/>
                                                    </MultiBinding>
                                                </DataGridTextColumn.Binding>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Net à payer" Binding="{Binding NetAPayer, StringFormat=N2}" Width="110"/>
                                            <DataGridTextColumn Header="IPR net" Binding="{Binding MontantIprNet, StringFormat=N2}" Width="100"/>
                                            <DataGridTextColumn Header="CNSS" Binding="{Binding CotisationCnssOuvrier, StringFormat=N2}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Déclarations CNSS / IPR (menu 5) -->
                <Border Grid.Row="4" CornerRadius="14" Padding="0" ClipToBounds="True"
                        BorderBrush="#E2E8F0" BorderThickness="1"
                        Visibility="{Binding MenuSelectionne, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=5}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F5FBF9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.10"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="20,16">
                            <Border.Background>
                                <DynamicResource ResourceKey="BrandGradientBrush"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="44" Height="44" CornerRadius="12" Background="#30FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FileDocument" Width="26" Height="26" Foreground="White"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Déclarations CNSS &amp; IPR" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Exports officiels paramétrables (CNSS e-déclaration, DGI IPR, livre arrêté 2008, virements) et clôture avec contrôles."
                                                   FontSize="12" Foreground="#D1FAE5" TextWrapping="Wrap" MaxWidth="520" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#25FFFFFF" CornerRadius="10" Padding="12,8" VerticalAlignment="Center" BorderBrush="#40FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Période déclarée" FontSize="10" Foreground="#D1FAE5"/>
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:D2} / {1}">
                                                    <Binding Path="PeriodeSelectionneePourDeclarations.Mois" FallbackValue="—"/>
                                                    <Binding Path="PeriodeSelectionneePourDeclarations.Annee" FallbackValue=""/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="20,16,20,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="White" CornerRadius="12" Padding="16,14" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="CalendarMonth" Width="18" Height="18" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Période" FontWeight="SemiBold" FontSize="13" Foreground="#37474F" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding PeriodesPaie}"
                                                  SelectedItem="{Binding PeriodeSelectionneePourDeclarations, Mode=TwoWay}"
                                                  IsEditable="False">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding Mois}"/>
                                                        <Run Text="/"/>
                                                        <Run Text="{Binding Annee}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Margin="16,0,0,0" Background="White" CornerRadius="12" Padding="14,12" BorderBrush="#A7F3D0" BorderThickness="1" VerticalAlignment="Stretch">
                                    <DockPanel LastChildFill="True">
                                        <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Filter" Width="20" Height="20" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Filtrer la liste des bulletins" FontSize="12" Foreground="#607D8B" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding FiltreBulletins, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Matricule, nom, prénom…"
                                                     Padding="10,8"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <!-- Synthèse -->
                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,6,0" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="AccountGroup" Width="24" Height="24" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Employés" FontSize="11" Foreground="#78909C"/>
                                        <TextBlock Text="{Binding DeclarationNbEmployes, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="#004D40"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="3,0,3,0" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="CurrencyUsd" Width="24" Height="24" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Masse salariale" FontSize="11" Foreground="#78909C"/>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#004D40">
                                            <Run Text="{Binding DeclarationMasseSalariale, StringFormat=N0, Mode=OneWay}"/><Run Text=" USD" FontSize="11"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="3,0,3,0" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="Receipt" Width="24" Height="24" Foreground="#E65100" Margin="0,0,0,8"/>
                                        <TextBlock Text="IPR total" FontSize="11" Foreground="#78909C"/>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#BF360C">
                                            <Run Text="{Binding DeclarationTotalIpr, StringFormat=N0, Mode=OneWay}"/><Run Text=" USD" FontSize="11"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="6,0,0,0" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="Shield" Width="24" Height="24" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="CNSS ouvrier" FontSize="11" Foreground="#78909C"/>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#065F46">
                                            <Run Text="{Binding DeclarationTotalCnss, StringFormat=N0, Mode=OneWay}"/><Run Text=" USD" FontSize="11"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="2" Background="#ECFDF5" CornerRadius="12" BorderBrush="#A7F3D0" BorderThickness="1" Padding="12,10" Margin="0,0,0,14">
                                <StackPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Command="{Binding ExportDeclarationCnssCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileDelimited" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="CNSS (CSV)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExportDeclarationIprCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileDelimited" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="IPR (CSV)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExportDeclarationCnssExcelCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="MicrosoftExcel" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="CNSS (Excel)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExportDeclarationIprExcelCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="MicrosoftExcel" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="IPR (Excel)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExportLivrePaiePdfCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="Livre de paie (PDF)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExportLivrePaieExcelCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="BookOpenVariant" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="Livre (Excel)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding SynchroniserLivrePaieCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8"
                                                ToolTip="Recharge le livre à partir des bulletins et montants actuels de la période">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Sync" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="Synchroniser le livre" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExportCnssEdeclarationCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignRaisedButton}" Background="#00695C" Foreground="White"
                                                materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CloudUpload" Width="18" Height="18" Margin="0,0,8,0" Foreground="White"/>
                                                <TextBlock Text="CNSS e-déclaration" VerticalAlignment="Center" Foreground="White"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExportFeuillePaieCnssCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileTable" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="Feuille de paie CNSS" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExportDgiIprCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignRaisedButton}" Background="#283593" Foreground="White"
                                                materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Bank" Width="18" Height="18" Margin="0,0,8,0" Foreground="White"/>
                                                <TextBlock Text="DGI IPR" VerticalAlignment="Center" Foreground="White"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExportLivreReglementairePdfCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Gavel" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="Livre réglementaire (PDF)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExportLivreReglementaireExcelCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Table" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="Livre réglementaire (Excel)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExportVirementCommand}" Margin="0,4,8,4"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
