                                </Border>

                                <Grid Grid.Row="1" MinHeight="280">
                                    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Stretch">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                                    </Border.Effect>
                                    <!-- Hauteur bornée : sans cela le ScrollViewer parent donne une mesure infinie et la grille désactive la virtualisation des lignes. -->
                                    <DataGrid x:Name="GrilleEmployes"
                                              ItemsSource="{Binding Employes}"
                                              SelectedItem="{Binding EmployeSelectionne, Mode=TwoWay}"
                                              MouseDoubleClick="GrilleEmployes_MouseDoubleClick"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#ECEFF1"
                                              Background="Transparent"
                                              RowBackground="White"
                                              AlternatingRowBackground="#F0FDF4"
                                              BorderThickness="0"
                                              RowHeight="38"
                                              MaxHeight="560"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.CanContentScroll="True"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              EnableColumnVirtualization="True">
                                        <DataGrid.RowStyle>
                                            <StaticResource ResourceKey="MelodyDataGridRowStyle"/>
                                        </DataGrid.RowStyle>
                                        <DataGrid.ColumnHeaderStyle>
                                            <StaticResource ResourceKey="MelodyDataGridHeaderStyle"/>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="110"/>
                                            <DataGridTextColumn Header="Employé" Binding="{Binding NomComplet}" Width="*" MinWidth="180"/>
                                            <DataGridTextColumn Header="Département" Binding="{Binding Departement.NomDepartement}" Width="160"/>
                                            <DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone}" Width="130"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    </Border>

                                    <Border CornerRadius="12" Background="#F8FAFC" BorderBrush="#A7F3D0" BorderThickness="1"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="24" Padding="32,28">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NbEmployes}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                                            <materialDesign:PackIcon Kind="AccountPlusOutline" Width="48" Height="48" Foreground="{DynamicResource BrandPrimaryBrush}"
                                                                     HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                            <TextBlock Text="Aucun employé pour cette entreprise" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrandPrimaryBrush}" TextAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="Créez votre premier dossier pour démarrer le pointage, les contrats et la paie."
                                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#546E7A" FontSize="13" Margin="0,0,0,20"/>
                                            <Button Command="{Binding NouvelEmployeCommand}" HorizontalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="18,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Créer le premier employé" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountDetails" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="Fiche" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <views:EmployeFichePanel x:Name="PanneauEmployeFiche"/>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="Contrats" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <views:EmployeModuleAccesPanel x:Name="PanneauEmployeContrats"
                                        Titre="Contrats de travail"
                                        Description="Gérez le contrat actif, les exports PDF et la fin de contrat."
                                        ActionLibelle="Gérer les contrats"
                                        IconKind="FileDocumentOutline"
                                        OuvrirCommand="{Binding OuvrirContratsCommand}"/>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountChild" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ayants droit" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <views:EmployeAyantsDroitPanel x:Name="PanneauEmployeAyantsDroit"/>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CashMultiple" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="Prêts" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <views:EmployePretsAvancesPanel x:Name="PanneauEmployePrets"/>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="GiftOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="Primes" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <views:EmployePrimesPanel x:Name="PanneauEmployePrimes"/>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ClockTimeFourOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="Heures" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <views:EmployeModuleAccesPanel x:Name="PanneauEmployeHeures"
