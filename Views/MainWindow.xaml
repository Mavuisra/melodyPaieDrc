                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountGroupOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="Répertoire" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Actions essentielles -->
                                <Border Grid.Row="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10" Margin="0,0,0,14">
                                    <DockPanel LastChildFill="False">
                                        <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                            <Button Command="{Binding NouvelEmployeCommand}" Margin="0,0,8,0"
                                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Nouvel employé" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ModifierEmployeCommand}" Margin="0,0,8,0"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Modifier" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding SupprimerEmployeCommand}" Margin="0,0,8,0"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Supprimer" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding RafraichirCommand}" Margin="0,0,8,0"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Rafraîchir" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding OuvrirFicheEmployeCommand}" Margin="0,0,8,0"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8"
                                                    ToolTip="Ouvrir la fiche de l'employé sélectionné">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AccountDetails" Width="18" Height="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Fiche" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding OuvrirContratsCommand}" Margin="0,0,8,0"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Contrat" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding OuvrirHistoriquePointageEmployeCommand}" Margin="0,0,8,0"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8"
                                                    ToolTip="Historique des pointages de la période">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ClockOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Pointage" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding OuvrirAbsencesCongesEmployeCommand}" Margin="0,0,8,0"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CalendarRemoveOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Congés" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding OuvrirPretsAvancesCommand}" Margin="0,0,8,0"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CashMultiple" Width="18" Height="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Prêts" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding OuvrirPaieEmployeCommand}" Margin="0,0,0,0"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Calculator" Width="18" Height="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Paie" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   Text="Sélectionnez un employé, puis un raccourci — double-clic ouvre la fiche"
