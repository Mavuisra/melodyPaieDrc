                        <Border Grid.Row="0" Padding="20,16">
                            <Border.Background>
                                <DynamicResource ResourceKey="BrandGradientBrush"/>
                            </Border.Background>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="44" Height="44" CornerRadius="22" Background="#33FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="AccountGroup" Width="26" Height="26" Foreground="White"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Répertoire des employés" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock FontSize="12" Foreground="#D1FAE5" TextWrapping="Wrap" MaxWidth="560" Margin="0,4,0,0">
                                                <Run Text="Entreprise : "/>
                                                <Run Text="{Binding EntrepriseCouranteLibelle, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" — seuls les employés rattachés à cette entreprise sont affichés."/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="20" Padding="14,8" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountMultiple" Width="20" Height="20" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Foreground="White" FontSize="13" VerticalAlignment="Center">
                                                <Run Text="{Binding NbEmployes, Mode=OneWay}" FontWeight="Bold"/>
                                                <Run Text=" enregistré(s)" FontWeight="Normal"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <!-- Recherche sous le bandeau -->
                                <Border Grid.Row="1" Margin="0,16,0,0" Background="White" CornerRadius="12" Padding="4,4,4,4"
                                        BorderBrush="#A7F3D0" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                                    </Border.Effect>
                                    <DockPanel Margin="10,6">
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding EffacerFiltreEmployesCommand}"
                                                ToolTip="Effacer la recherche"
                                                Margin="4,0,0,0"
                                                Padding="6">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconForegroundButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AfficherEffacerFiltreEmployes}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <materialDesign:PackIcon Kind="CloseCircleOutline" Width="20" Height="20"/>
                                        </Button>
                                        <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Width="20" Height="20" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBox x:Name="RechercheEmployesTextBox"
                                                     BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="14"
                                                     Text="{Binding FiltreEmployes, UpdateSourceTrigger=PropertyChanged}"
                                                     PreviewKeyDown="RechercheEmployesTextBox_PreviewKeyDown"
                                                     materialDesign:HintAssist.Hint="Recherche intelligente : nom, matricule, téléphone, CNSS, département, banque…"/>
                                            <Border Margin="0,6,0,0" Background="White" CornerRadius="8"
                                                    BorderBrush="#A7F3D0" BorderThickness="1" MaxHeight="260">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AfficherSuggestionsEmployes}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12"/>
                                                </Border.Effect>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding SuggestionsEmployes}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource EmployeSuggestionButtonStyle}"
                                                                        Command="{Binding DataContext.SelectionnerSuggestionEmployeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <materialDesign:PackIcon Kind="AccountOutline" Width="18" Height="18"
                                                                                                 Foreground="{DynamicResource BrandPrimaryBrush}"
                                                                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis">
                                                                                <Run Text="{Binding NomComplet, Mode=OneWay}"/>
                                                                            </TextBlock>
                                                                            <TextBlock FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis">
                                                                                <Run Text="Matricule "/>
                                                                                <Run Text="{Binding Matricule, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                                <Run Text=" · "/>
                                                                                <Run Text="{Binding Departement.NomDepartement, Mode=OneWay, TargetNullValue=—}"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                        <materialDesign:PackIcon Grid.Column="2" Kind="ChevronRight" Width="16" Height="16"
                                                                                                 Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                            <TextBlock Text="{Binding FiltreEmployesResultatLibelle, Mode=OneWay}"
                                                       FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Padding="20,12,20,20" Background="Transparent">
