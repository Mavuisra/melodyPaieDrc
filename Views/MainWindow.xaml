                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="EmployeContextNom" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                            <TextBlock x:Name="EmployeContextMeta" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8"
                                                   Text="Dossier employé"/>
                                    </Grid>
                                </Border>
                            <TabControl x:Name="EmployesTabControl" Grid.Row="1"
                                        Style="{StaticResource EmployeTabControlStyle}"
