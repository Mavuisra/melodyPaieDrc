<Window x:Class="MelodyPaieRDC.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:MelodyPaieRDC.Views"
        xmlns:helpers="clr-namespace:MelodyPaieRDC.Helpers"
        Title="Melody Paie RDC" Height="620" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Window.Resources>
        <!-- Sidebar : palette entreprise (clés définies dans Themes/BrandResources.xaml) -->
        <helpers:MenuIndexEqualsConverter x:Key="MenuIndexEqualsConverter"/>
        <helpers:MenuIndexActiveConverter x:Key="MenuIndexActiveConverter"/>
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <!-- Barre latérale — style moderne épuré -->
        <Style x:Key="SidebarSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="EmployeSuggestionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECFDF5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D1FAE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmployeTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource EmployeOngletTabItemStyle}"/>
        <Style x:Key="EmployeTabControlStyle" TargetType="TabControl" BasedOn="{StaticResource EmployeOngletTabControlStyle}"/>

        <Style x:Key="SidebarBadgeDotStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,-4,-4,0"/>
            <Setter Property="BorderBrush" Value="#152238"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="SidebarBadgeChecklistStyle" TargetType="Border" BasedOn="{StaticResource SidebarBadgeDotStyle}">
            <Setter Property="Background" Value="#F97316"/>
            <Setter Property="ToolTip" Value="Étapes restantes"/>
        </Style>
        <Style x:Key="SidebarBadgePointageStyle" TargetType="Border" BasedOn="{StaticResource SidebarBadgeDotStyle}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="ToolTip" Value="Nouveaux pointages"/>
        </Style>
        <Style x:Key="SidebarBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Margin="12,2"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
                <Trigger Property="helpers:SidebarNavHelper.IsActive" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource SidebarAccentBrush}"/>
                    <Setter Property="BorderThickness" Value="4,0,0,0"/>
                    <Setter Property="Padding" Value="18,11,14,11"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarLogoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Se déconnecter"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#243044"/>
                                <Setter Property="Foreground" Value="#F87171"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarCompanyComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="materialDesign:ComboBoxAssist.ShowSelectedItem" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#0F172A"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

                <!-- Cards KPI premium : design asymétrique avec accents -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.18"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Cartes indicateurs tableau de bord -->
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4EAF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FAFCFF"/>
                    <Setter Property="BorderBrush" Value="#B8D4F0"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.14"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <helpers:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter"/>
        <helpers:StringToDecimalConverter x:Key="StringToDecimalConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Pages contenu — palette Melody unifiée -->
        <Style x:Key="PageShellBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="PageHeroBannerStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Background" Value="{DynamicResource BrandGradientBrush}"/>
        </Style>
        <Style x:Key="PageActionsBarStyle" TargetType="Border">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style x:Key="MelodyDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#065F46"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="MelodyDataGridSubHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="Foreground" Value="#047857"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="MelodyDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#A7F3D0"/>
                    <Setter Property="Foreground" Value="#065F46"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#6EE7B7"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColonneMenu" Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu latéral — navigation moderne -->
        <Border x:Name="PanneauMenuLateral" Grid.Column="0" ClipToBounds="True" BorderBrush="{DynamicResource SidebarHoverBrush}" BorderThickness="0,0,1,0"
                Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,20,16,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0"
                                Background="{DynamicResource BrandGradientBrush}">
                            <Image Source="pack://application:,,,/MelodyPaieRDC;component/Assets/Icon_MelodyPaie.png"
                                   Width="24" Height="24" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Melody Paie" FontSize="17" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Paie RDC" FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#1E293B" CornerRadius="14" Padding="10,8" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Domain" Width="18" Height="18" Foreground="#64748B"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource SidebarCompanyComboStyle}"
                                      ItemsSource="{Binding EntreprisesDisponibles}"
                                      SelectedItem="{Binding EntrepriseCouranteSelection, Mode=TwoWay}"
                                      DisplayMemberPath="RaisonSociale"
                                      Validation.ErrorTemplate="{x:Null}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,4,0,8">
                    <StackPanel>
                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="0"
                                helpers:SidebarNavHelper.IsActive="{Binding MenuSelectionne, Converter={StaticResource MenuIndexActiveConverter}, ConverterParameter=0}"
                                Command="{Binding SelectionnerMenuCommand}" CommandParameter="0">
                                                        <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="26" Height="26" Margin="0,0,14,0">
                                    <materialDesign:PackIcon Kind="Home" Width="22" Height="22" VerticalAlignment="Center"
                                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    <Border Style="{StaticResource SidebarBadgeChecklistStyle}"
                                            Visibility="{Binding AfficherBadgeChecklist, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding BadgeChecklistLibelle}" Style="{StaticResource SidebarBadgeTextStyle}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="Accueil" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="1"
                                helpers:SidebarNavHelper.IsActive="{Binding MenuSelectionne, Converter={StaticResource MenuIndexActiveConverter}, ConverterParameter=1}"
                                Command="{Binding SelectionnerMenuCommand}" CommandParameter="1">
                                                        <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="26" Height="26" Margin="0,0,14,0">
                                    <materialDesign:PackIcon Kind="CalendarClock" Width="22" Height="22" VerticalAlignment="Center"
                                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    <Border Style="{StaticResource SidebarBadgePointageStyle}"
                                            Visibility="{Binding AfficherBadgePointage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding BadgePointageLibelle}" Style="{StaticResource SidebarBadgeTextStyle}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="Pointage" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="2"
                                helpers:SidebarNavHelper.IsActive="{Binding MenuSelectionne, Converter={StaticResource MenuIndexActiveConverter}, ConverterParameter=2}"
                                Command="{Binding SelectionnerMenuCommand}" CommandParameter="2">
                                                        <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClockOutline" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                <TextBlock Text="Heures" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="3"
                                helpers:SidebarNavHelper.IsActive="{Binding MenuSelectionne, Converter={StaticResource MenuIndexActiveConverter}, ConverterParameter=3}"
                                Command="{Binding SelectionnerMenuCommand}" CommandParameter="3">
                                                        <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                <TextBlock Text="Employés" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{DynamicResource SidebarHoverBrush}" Margin="20,10" Opacity="0.55"/>
                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="4"
                                helpers:SidebarNavHelper.IsActive="{Binding MenuSelectionne, Converter={StaticResource MenuIndexActiveConverter}, ConverterParameter=4}"
                                Command="{Binding SelectionnerMenuCommand}" CommandParameter="4">
                                                        <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Calculator" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                <TextBlock Text="Calcul" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="7"
                                helpers:SidebarNavHelper.IsActive="{Binding MenuSelectionne, Converter={StaticResource MenuIndexActiveConverter}, ConverterParameter=7}"
                                Command="{Binding SelectionnerMenuCommand}" CommandParameter="7">
                                                        <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Receipt" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                <TextBlock Text="Bulletins" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="5"
                                helpers:SidebarNavHelper.IsActive="{Binding MenuSelectionne, Converter={StaticResource MenuIndexActiveConverter}, ConverterParameter=5}"
                                Command="{Binding SelectionnerMenuCommand}" CommandParameter="5">
                                                        <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocument" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                <TextBlock Text="Déclarations" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="8"
                                helpers:SidebarNavHelper.IsActive="{Binding MenuSelectionne, Converter={StaticResource MenuIndexActiveConverter}, ConverterParameter=8}"
                                Command="{Binding SelectionnerMenuCommand}" CommandParameter="8">
                                                        <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileChart" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                <TextBlock Text="Rapport" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{DynamicResource SidebarHoverBrush}" Margin="20,10" Opacity="0.55"/>
                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="6"
                                helpers:SidebarNavHelper.IsActive="{Binding MenuSelectionne, Converter={StaticResource MenuIndexActiveConverter}, ConverterParameter=6}"
                                Command="{Binding SelectionnerMenuCommand}" CommandParameter="6">
                                                        <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cog" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                <TextBlock Text="Paramètres" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="12,12,12,16" BorderBrush="{DynamicResource SidebarHoverBrush}" BorderThickness="0,1,0,0" Opacity="0.92">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,10,0"
                                Background="{DynamicResource BrandGradientBrush}">
                            <TextBlock Text="{Binding InitialesUtilisateurConnecte, Mode=OneWay}"
                                       FontSize="13" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NomUtilisateurCourt, Mode=OneWay}"
                                       FontSize="13" FontWeight="Bold" Foreground="#F1F5F9"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding RoleUtilisateurLibelle, Mode=OneWay}"
                                       FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding DeconnecterCommand}"
                                Style="{StaticResource SidebarLogoutButtonStyle}" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Logout" Width="20" Height="20"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Zone centrale fond gris clair -->
        <ScrollViewer x:Name="MainContentScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#F5F5F5"
                      SizeChanged="MainContentScrollViewer_SizeChanged">
            <Grid x:Name="ContenuPrincipalGrid" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Bandeau lecture seule uniquement -->
                <Border Grid.Row="0" Margin="0,0,0,12" CornerRadius="12" Padding="14,10" BorderBrush="#FFE0B2" BorderThickness="1"
                        Visibility="{Binding AfficherBandeauLectureSeule, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Background>
                        <SolidColorBrush Color="#FFF8E1"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="EyeOff" Width="20" Height="20" Foreground="#E65100" Margin="0,0,10,0"/>
                        <TextBlock Text="Mode lecture seule — les modifications sont désactivées." FontSize="13" Foreground="#E65100" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Notifications non bloquantes -->
                <Border x:Name="BandeauNotification" Grid.Row="1" Margin="0,0,0,12" CornerRadius="10" Padding="12,8"
                        Visibility="Collapsed" BorderThickness="1" BorderBrush="#A5D6A7" Background="#E8F5E9">
                    <DockPanel LastChildFill="True">
                        <materialDesign:PackIcon x:Name="IconeNotification" DockPanel.Dock="Left" Kind="InformationOutline" Width="18" Height="18" Margin="0,0,10,0" Foreground="#2E7D32"/>
                        <TextBlock x:Name="TexteNotification" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5" Foreground="#1B5E20"/>
                    </DockPanel>
                </Border>

                <!-- En-tête section (masqué sur Accueil et Pointage) -->
                <Border Grid.Row="2" Margin="0,0,0,24">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MenuSelectionne}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MenuSelectionne}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="4" CornerRadius="2" VerticalAlignment="Stretch" Margin="0,2,16,2"
                                Background="{DynamicResource BrandGradientBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="11" Foreground="{DynamicResource BrandPrimaryBrush}" FontWeight="Bold" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="ACCUEIL"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MenuSelectionne}" Value="2">
                                                <Setter Property="Text" Value="TEMPS"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MenuSelectionne}" Value="3">
                                                <Setter Property="Text" Value="RH"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MenuSelectionne}" Value="4">
                                                <Setter Property="Text" Value="PAIE"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MenuSelectionne}" Value="5">
                                                <Setter Property="Text" Value="DÉCLARATIONS"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MenuSelectionne}" Value="6">
                                                <Setter Property="Text" Value="ADMIN"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MenuSelectionne}" Value="7">
                                                <Setter Property="Text" Value="PAIE"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MenuSelectionne}" Value="8">
