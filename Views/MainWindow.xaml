                                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#1B5E20">
                                            <Run Text="{Binding BulletinsGeneresSommeNetListe, StringFormat=N0, Mode=OneWay}"/><Run Text=" USD" FontSize="11"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

