                                            Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Eye" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="Voir le bulletin" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding TelechargerBulletinCommand}" Margin="0,4,8,4"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="Télécharger PDF (A5)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding TelechargerTousBulletinsCommand}" Margin="0,4,8,4"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderDownload" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="Feuille A4 (2 bulletins A5)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SupprimerBulletinCommand}" Margin="0,4,8,4"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="Supprimer le bulletin" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="0,4,8,4"
                                            Click="SupprimerBulletinsSelection_Click"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8"
                                            ToolTip="Sélectionnez plusieurs lignes dans le tableau puis cliquez ici">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DeleteSweep" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="Supprimer la sélection" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ActualiserBulletinsGeneresCommand}" Margin="0,4,0,4"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8"
                                            ToolTip="Recharger la liste depuis la base">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="Actualiser" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Border>

                            <Border Grid.Row="3" Background="White" CornerRadius="12" BorderBrush="#E4EAF2" BorderThickness="1" MinHeight="200" VerticalAlignment="Stretch">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="0,0,0,1" Padding="16,12">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="History" Width="20" Height="20" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Historique des bulletins" FontWeight="SemiBold" FontSize="14" Foreground="#065F46" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <DataGrid x:Name="BulletinsGeneresDataGrid"
                                              Grid.Row="1"
                                              ItemsSource="{Binding TousBulletins}"
                                              SelectedItem="{Binding BulletinSelectionne, Mode=TwoWay}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#ECEFF1"
                                              Background="Transparent"
                                              RowBackground="White"
                                              AlternatingRowBackground="#F0FDF4"
                                              BorderThickness="0"
                                              RowHeight="38"
                                              MaxHeight="560"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.CanContentScroll="True"
                                              EnableColumnVirtualization="True"
                                              SelectionMode="Extended" SelectionUnit="FullRow">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#EFEBE9"/>
                                                <Setter Property="Foreground" Value="#4E342E"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Padding" Value="12,10"/>
                                                <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="N° bulletin" Binding="{Binding NumeroBulletin}" Width="105"/>
                                            <DataGridTextColumn Header="Matricule" Binding="{Binding Employe.Matricule}" Width="88"/>
                                            <DataGridTextColumn Header="Employé" Width="*">
                                                <DataGridTextColumn.Binding>
                                                    <MultiBinding StringFormat="{}{0} {1} {2}">
                                                        <Binding Path="Employe.Nom"/>
                                                        <Binding Path="Employe.Postnom"/>
                                                        <Binding Path="Employe.Prenom"/>
                                                    </MultiBinding>
                                                </DataGridTextColumn.Binding>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Département" Binding="{Binding Employe.Departement.NomDepartement}" Width="110"/>
                                            <DataGridTextColumn Header="Période" Width="82">
                                                <DataGridTextColumn.Binding>
                                                    <MultiBinding StringFormat="{}{0:D2}/{1}">
                                                        <Binding Path="PeriodePaie.Mois" FallbackValue="0"/>
                                                        <Binding Path="PeriodePaie.Annee" FallbackValue="0"/>
                                                    </MultiBinding>
                                                </DataGridTextColumn.Binding>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Brut" Binding="{Binding SalaireBrut, StringFormat=N2}" Width="92"/>
                                            <DataGridTextColumn Header="Net" Binding="{Binding NetAPayer, StringFormat=N2}" Width="95"/>
                                            <DataGridTextColumn Header="IPR" Binding="{Binding MontantIprNet, StringFormat=N2}" Width="88"/>
                                            <DataGridTextColumn Header="CNSS" Binding="{Binding CotisationCnssOuvrier, StringFormat=N2}" Width="82"/>
                                            <DataGridTextColumn Header="Généré le" Binding="{Binding DateGeneration, StringFormat=d}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Paramètres (menu 6) -->
                <Border Grid.Row="4" Margin="0,0,0,8"
                        Visibility="{Binding MenuSelectionne, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=6}">
                    <views:ParametresPanel DataContext="{Binding}"/>
                </Border>

                <!-- Tableau de bord (menu 0) — panneau moderne vert -->
                <Border Grid.Row="4" Visibility="{Binding AfficherContenuGenerique, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,0,0,8">
                    <views:DashboardAccueilPanel DataContext="{Binding}"/>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- Toasts pointage temps réel (tous écrans) -->
        <views:PointageLiveToastOverlay Grid.ColumnSpan="2"
                                        Panel.ZIndex="9999"
                                        IsHitTestVisible="False"/>
    </Grid>
</Window>
