<Window x:Class="MelodyPaieRDC.Views.ContratsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:MelodyPaieRDC.Helpers"
        Title="Contrats"
        Height="640" Width="860"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Window.Resources>
        <helpers:CdiToVisibilityConverter x:Key="CdiToVisibilityConverter"/>
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Bandeau identité visuelle -->
        <Border Grid.Row="0" Style="{StaticResource PageHeroBannerStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="22" Background="#33FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="26" Height="26" Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Contrats de travail" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock FontSize="12" Foreground="#D1FAE5" TextWrapping="Wrap" MaxWidth="520" Margin="0,4,0,0">
                            <Run Text="Employé : "/>
                            <Run FontWeight="SemiBold">
                                <Run.Text>
                                    <Binding Path="NomEmploye" Mode="OneWay"/>
                                </Run.Text>
                            </Run>
                            <Run Text=" — gestion du contrat actif, export PDF et fin de contrat."/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="20" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileSign" Width="20" Height="20" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Foreground="White" FontSize="13" VerticalAlignment="Center"
                                   Text="{Binding NbContrats, Mode=OneWay, StringFormat='{}{0} contrat(s)'}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,20">
            <StackPanel>
                <!-- Barre d'actions -->
                <Border Style="{StaticResource PageActionsBarStyle}" Margin="0,0,0,14">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding ModifierCommand}" Margin="0,4,8,4"
                                    Style="{StaticResource BrandRaisedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Modifier" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ExporterPdfCommand}" Margin="0,4,8,4"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Exporter PDF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="0,4,8,4" Click="FinContrat_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CalendarRemove" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Fin de contrat" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SupprimerCommand}" Margin="0,4,0,4"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Supprimer" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </ScrollViewer>
                </Border>

                <!-- Formulaire nouveau contrat (un seul contrat autorisé) -->
                <Border Style="{StaticResource MelodyFormCardStyle}" Margin="0,0,0,14"
                        Visibility="{Binding AfficherFormulaireAjout, Converter={StaticResource BooleanToVisibilityConverter}}"
                        IsEnabled="{Binding PeutModifier}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="FilePlusOutline" Width="22" Height="22"
                                                     Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Nouveau contrat" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                <TextBlock Text="Créez le contrat de travail pour activer le pointage et la paie."
                                           FontSize="11" Foreground="#78909C" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="Type *" Style="{StaticResource MelodyFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding TypesContrat}" SelectedItem="{Binding NouveauContrat.TypeContrat, Mode=TwoWay}"
                                          IsEditable="False" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="Date début *" Style="{StaticResource MelodyFieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding NouveauContrat.DateDebut, Mode=TwoWay}"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10"
                                        Visibility="{Binding NouveauContrat.TypeContrat, Converter={StaticResource CdiToVisibilityConverter}}">
                                <TextBlock Text="Date fin *" Style="{StaticResource MelodyFieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding NouveauContrat.DateFin, Mode=TwoWay}"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="Salaire de base *" Style="{StaticResource MelodyFieldLabelStyle}"/>
                                <TextBox Text="{Binding NouveauContrat.SalaireBase, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="≈ " Foreground="#78909C" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NouveauContrat.SalaireJour, StringFormat='Jour : {0:N2}'}" Foreground="#78909C" FontSize="11" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding NouveauContrat.SalaireHeure, StringFormat='Heure : {0:N2}'}" Foreground="#78909C" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="Devise" Style="{StaticResource MelodyFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Devises}" SelectedItem="{Binding NouveauContrat.DeviseBase, Mode=TwoWay}"
                                          IsEditable="False" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,10">
                                <TextBlock Text="Catégorie professionnelle *" Style="{StaticResource MelodyFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Libelle" SelectedValuePath="Id"
                                          SelectedValue="{Binding NouveauContrat.CategorieProfessionnelleId, Mode=TwoWay}"
                                          IsEditable="False" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,0">
                                <TextBlock Text="Majoration heures sup. (%)" Style="{StaticResource MelodyFieldLabelStyle}"/>
                                <TextBox Text="{Binding NouveauContrat.TauxMajorationHeuresSup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,0">
                                <TextBlock Text="Majoration nuit (%)" Style="{StaticResource MelodyFieldLabelStyle}"/>
                                <TextBox Text="{Binding NouveauContrat.TauxMajorationNuit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,0,0,0">
                                <TextBlock Text="Majoration jours fériés (%)" Style="{StaticResource MelodyFieldLabelStyle}"/>
                                <TextBox Text="{Binding NouveauContrat.TauxMajorationJourFerie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Préavis (mois de salaire)" Style="{StaticResource MelodyFieldLabelStyle}"/>
                                <TextBox Text="{Binding NouveauContrat.PreavisMoisBase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Indemnité de licenciement (mois)" Style="{StaticResource MelodyFieldLabelStyle}"/>
                                <TextBox Text="{Binding NouveauContrat.IndemniteLicenciementMoisBase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <Button Command="{Binding AjouterCommand}" Margin="0,16,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource BrandRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8" Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Ajouter le contrat" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Grille contrats -->
                <Border Style="{StaticResource MelodyFormCardStyle}" Padding="0"
                        Visibility="{Binding AfficherFormulaireAjout, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                    </Border.Effect>
                    <DataGrid ItemsSource="{Binding Contrats}" SelectedItem="{Binding Selectionne, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#ECEFF1"
                              Background="Transparent" RowBackground="White"
                              AlternatingRowBackground="#F0FDF4" BorderThickness="0"
                              RowHeight="38" MinHeight="120">
                        <DataGrid.RowStyle>
                            <StaticResource ResourceKey="MelodyDataGridRowStyle"/>
                        </DataGrid.RowStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <StaticResource ResourceKey="MelodyDataGridHeaderStyle"/>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeContrat}" Width="90"/>
                            <DataGridTextColumn Header="Début" Binding="{Binding DateDebut, StringFormat=dd/MM/yyyy}" Width="90"/>
                            <DataGridTextColumn Header="Fin" Binding="{Binding DateFin, StringFormat=dd/MM/yyyy}" Width="90"/>
                            <DataGridTextColumn Header="Salaire base" Binding="{Binding SalaireBase, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="{Binding SalaireJourEntete}" Binding="{Binding SalaireJour, Mode=OneWay, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="{Binding SalaireHeureEntete}" Binding="{Binding SalaireHeure, Mode=OneWay, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="Devise" Binding="{Binding DeviseBase}" Width="56"/>
                            <DataGridTextColumn Header="Catégorie" Binding="{Binding CategorieProfessionnelle.Libelle}" Width="*"/>
                            <DataGridTextColumn Header="HS (%)" Binding="{Binding TauxMajorationHeuresSup, StringFormat=N0}" Width="60"/>
                            <DataGridTextColumn Header="Nuit (%)" Binding="{Binding TauxMajorationNuit, StringFormat=N0}" Width="60"/>
                            <DataGridTextColumn Header="Férié (%)" Binding="{Binding TauxMajorationJourFerie, StringFormat=N0}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#78909C" TextWrapping="Wrap"
                           Visibility="{Binding EmployeDejaPaye, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Text="Note :"/>
                    <Run Text=" la suppression du contrat est désactivée car cet employé possède déjà au moins un bulletin de paie."/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
