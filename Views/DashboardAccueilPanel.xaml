<UserControl x:Class="MelodyPaieRDC.Views.DashboardAccueilPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="DashHeroKpiCard" TargetType="Border">
            <Setter Property="Background" Value="#28FFFFFF"/>
            <Setter Property="BorderBrush" Value="#45FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="DashHeroKpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#D1FAE5"/>
        </Style>
        <Style x:Key="DashHeroKpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="DashHeroKpiSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#ECFDF5"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="DashRefreshButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" Color="#0F172A"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0FDF4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCFCE7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DashFilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#ECFDF5"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="DashKpiCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.08" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DashKpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>
        <Style x:Key="DashKpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style x:Key="DashChecklistRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstTermine}" Value="True">
                    <Setter Property="Background" Value="#F0FDF4"/>
                    <Setter Property="BorderBrush" Value="#4ADE80"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding EstProchaineEtape}" Value="True">
                    <Setter Property="Background" Value="#FFF7ED"/>
                    <Setter Property="BorderBrush" Value="#FB923C"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="4,0,4,24">
        <!-- Sans employés -->
        <Border Margin="0,0,0,20" CornerRadius="14" Padding="16,14" BorderBrush="#FB923C" BorderThickness="1.5" Background="#FFF7ED">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NbEmployes}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding NouvelEmployeCommand}"
                        Background="#EA580C" Foreground="White" BorderThickness="0"
                        FontWeight="Bold" FontSize="14" Cursor="Hand"
                        materialDesign:ButtonAssist.CornerRadius="12" Padding="20,12" Margin="16,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="12" Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" Color="#EA580C"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#C2410C"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#9A3412"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Ajouter un employé" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Commencez par vos employés" FontWeight="Bold" FontSize="15" Foreground="#C2410C"/>
                    <TextBlock Text="Créez au moins un salarié pour lancer la paie." FontSize="13" Foreground="#9A3412" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bandeau tableau de bord -->
        <Border Margin="0,0,0,20" CornerRadius="20" ClipToBounds="True" BorderBrush="#065F46" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{DynamicResource BrandPrimaryColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource BrandSecondaryColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#047857"/>
            </Border.Effect>
            <Grid Margin="24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <materialDesign:PackIcon Kind="ViewDashboard" Width="18" Height="18" Foreground="#A7F3D0" Margin="0,0,8,0"/>
                        <TextBlock Text="TABLEAU DE BORD" FontSize="11" FontWeight="Bold" Foreground="#A7F3D0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="52" Height="52" CornerRadius="12" Background="#20FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1">
                        <materialDesign:PackIcon Kind="ChartTimelineVariant" Width="28" Height="28" Foreground="#ECFDF5"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,14,0,18">
                    <TextBlock Text="Vue rapide des indicateurs" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Suivez l'activité du jour et la tendance paie en un seul écran."
                               FontSize="14" Foreground="#D1FAE5" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="640"/>
                </StackPanel>

                <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,18">
                    <Border Style="{StaticResource DashHeroKpiCard}">
                        <StackPanel>
                            <TextBlock Text="Effectif" Style="{StaticResource DashHeroKpiLabel}"/>
                            <TextBlock Text="{Binding DashboardEffectifLibelle, Mode=OneWay}" Style="{StaticResource DashHeroKpiValue}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashHeroKpiCard}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="Enveloppe salariale" Style="{StaticResource DashHeroKpiLabel}"/>
                            <TextBlock Text="{Binding DashboardEnveloppeUsdLibelle, Mode=OneWay}" Style="{StaticResource DashHeroKpiValue}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding DashboardEnveloppeCdfLibelle, Mode=OneWay}" Style="{StaticResource DashHeroKpiSub}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashHeroKpiCard}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="Taux de change" Style="{StaticResource DashHeroKpiLabel}"/>
                            <TextBlock Text="{Binding DashboardTauxChangeLibelle, Mode=OneWay}" Style="{StaticResource DashHeroKpiValue}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding DashboardTauxChangePeriodeLibelle, Mode=OneWay}" Style="{StaticResource DashHeroKpiSub}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashHeroKpiCard}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="IPR du mois" Style="{StaticResource DashHeroKpiLabel}"/>
                            <TextBlock Text="{Binding DashboardIprLibelle, Mode=OneWay}" Style="{StaticResource DashHeroKpiValue}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="3" Background="#22FFFFFF" CornerRadius="14" Padding="14,12" BorderBrush="#35FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Date (présence)" Style="{StaticResource DashFilterLabel}"/>
                            <DatePicker SelectedDate="{Binding DashboardDatePresence, Mode=TwoWay}"
                                        materialDesign:HintAssist.Hint="Jour"
                                        Foreground="White"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Période de paie" Style="{StaticResource DashFilterLabel}"/>
                            <ComboBox ItemsSource="{Binding PeriodesPaie}"
                                      SelectedItem="{Binding PeriodeSelectionneeDashboard, Mode=TwoWay}"
                                      materialDesign:HintAssist.Hint="Mois / année">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding Mois, Mode=OneWay}"/>
                                            <Run Text=" / "/>
                                            <Run Text="{Binding Annee, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="4" Command="{Binding RafraichirTableauDeBordCommand}"
                                Style="{StaticResource DashRefreshButton}"
                                VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Rafraîchir"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Progression mois -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{Binding ProchaineEtapeLibelle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBlock Text="{Binding MoisPaieProgression, Mode=OneWay}" FontSize="13" FontWeight="Medium" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Checklist -->
        <Border Background="White" CornerRadius="18" Padding="20,18" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="À faire ce mois" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>
                <ItemsControl ItemsSource="{Binding ChecklistMoisPaie}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DashChecklistRow}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OuvrirCommand}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#CBD5E1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstTermine}" Value="True">
                                                        <Setter Property="Background" Value="#16A34A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EstProchaineEtape}" Value="True">
                                                        <Setter Property="Background" Value="#EA580C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Numero}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="Bold" Foreground="White" FontSize="14"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Libelle}" FontSize="15" FontWeight="Bold"
                                               Foreground="#1E293B" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Grid.Column="2" Kind="ChevronRight" Width="24" Height="24"
                                                             Foreground="#64748B" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Expander Margin="0,0,0,10" IsExpanded="False" materialDesign:ColorZoneAssist.Mode="Light">
            <Expander.Header>
                <TextBlock Text="Pointage du jour" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
            </Expander.Header>
            <UniformGrid Columns="4" Margin="0,10,0,4">
                <Border Background="#F0FDF4" CornerRadius="12" Padding="14,12" Margin="0,0,6,0" BorderBrush="#86EFAC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Présents" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                        <TextBlock Text="{Binding DashboardPointesAujourdhui, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#14532D" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#FFF7ED" CornerRadius="12" Padding="14,12" Margin="3,0" BorderBrush="#FDBA74" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Retards" FontSize="11" FontWeight="SemiBold" Foreground="#C2410C"/>
                        <TextBlock Text="{Binding DashboardRetardsAujourdhui, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#9A3412" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#FEF2F2" CornerRadius="12" Padding="14,12" Margin="3,0" BorderBrush="#FCA5A5" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Sans pointage" FontSize="11" FontWeight="SemiBold" Foreground="#B91C1C"/>
                        <TextBlock Text="{Binding DashboardSansPointageAujourdhui, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#991B1B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#EFF6FF" CornerRadius="12" Padding="14,12" Margin="6,0,0,0" BorderBrush="#93C5FD" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Présence" FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                        <TextBlock Text="{Binding DashboardTauxPresenceAujourdhuiLibelle, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Expander>

        <Expander IsExpanded="False" materialDesign:ColorZoneAssist.Mode="Light">
            <Expander.Header>
                <TextBlock Text="Historique et situation" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
            </Expander.Header>
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="{Binding DernierMoisTraite, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,12"/>
                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <Border Style="{StaticResource DashKpiCard}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Salaires nets" Style="{StaticResource DashKpiLabel}"/>
                            <TextBlock Text="{Binding SituationPaieMois.TotalSalairesNets, StringFormat=N0, Mode=OneWay}" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashKpiCard}" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="IPR retenus" Style="{StaticResource DashKpiLabel}"/>
                            <TextBlock Text="{Binding SituationPaieMois.TotalIprRetenus, StringFormat=N0, Mode=OneWay}" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashKpiCard}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="CNSS retenues" Style="{StaticResource DashKpiLabel}"/>
                            <TextBlock Text="{Binding SituationPaieMois.TotalCnssRetenues, StringFormat=N0, Mode=OneWay}" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <TextBlock Text="6 derniers mois" FontSize="13" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding DashboardMois}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3,0" Padding="4,0,4,4">
                                <StackPanel>
                                    <Border Height="80" CornerRadius="10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4,6">
                                        <Grid VerticalAlignment="Bottom">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="14" CornerRadius="4,4,0,0" Background="#059669" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                    Height="{Binding BarHeightMasse}"/>
                                            <Border Grid.Column="1" Width="14" CornerRadius="4,4,0,0" Background="#EA580C" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                    Height="{Binding BarHeightIpr}"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Libelle}" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
