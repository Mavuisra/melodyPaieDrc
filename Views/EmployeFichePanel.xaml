<UserControl x:Class="MelodyPaieRDC.Views.EmployeFichePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="FicheCard" TargetType="Border" BasedOn="{StaticResource EmployeOngletPanelCard}">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="MinWidth" Value="220"/>
        </Style>
        <Style x:Key="FicheLabel" TargetType="TextBlock" BasedOn="{StaticResource EmployeOngletFieldLabel}"/>
        <Style x:Key="FicheValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="#F8FAFC" CornerRadius="12" BorderBrush="#A7F3D0" BorderThickness="1"
                Padding="32,28" Margin="0,24,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AfficherFiche}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" MaxWidth="480">
                <materialDesign:PackIcon Kind="AccountDetailsOutline" Width="48" Height="48"
                                         Foreground="{DynamicResource BrandPrimaryBrush}"
                                         HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding MessageVide}" FontSize="14" Foreground="#64748B"
                           TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AfficherFiche}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="0,4,0,12">
                <Border Background="#F0FDF4" CornerRadius="12" BorderBrush="#BBF7D0" BorderThickness="1"
                        Padding="18,16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="28" Background="#DCFCE7" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="Account" Width="30" Height="30"
                                                     Foreground="{DynamicResource BrandPrimaryBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NomComplet}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="#64748B">
                                <Run Text="Matricule : "/>
                                <Run Text="{Binding Matricule, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                <Run Text="  ·  "/>
                                <Run Text="{Binding Departement, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Identité &amp; contact" Style="{StaticResource EmployeOngletSectionTitle}"/>
                <WrapPanel Margin="0,0,0,8">
                    <Border Style="{StaticResource FicheCard}"><StackPanel><TextBlock Text="Sexe" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding Sexe}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource FicheCard}"><StackPanel><TextBlock Text="État civil" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding EtatCivil}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource FicheCard}"><StackPanel><TextBlock Text="Date de naissance" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding DateNaissance}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource FicheCard}"><StackPanel><TextBlock Text="Téléphone" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding Telephone}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource FicheCard}" MinWidth="280"><StackPanel><TextBlock Text="Adresse" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding Adresse}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                </WrapPanel>

                <TextBlock Text="Affectation &amp; paie" Style="{StaticResource EmployeOngletSectionTitle}"/>
                <WrapPanel Margin="0,0,0,8">
                    <Border Style="{StaticResource FicheCard}"><StackPanel><TextBlock Text="Contrat actif" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding ContratActif}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource FicheCard}"><StackPanel><TextBlock Text="Salaire mensuel (USD)" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding SalaireUsd}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource FicheCard}"><StackPanel><TextBlock Text="Salaire mensuel (FC)" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding SalaireCdf}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource FicheCard}"><StackPanel><TextBlock Text="Salaire / jour (USD)" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding SalaireJourUsd}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource FicheCard}"><StackPanel><TextBlock Text="Salaire / h (USD)" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding SalaireHeureUsd}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                </WrapPanel>

                <TextBlock Text="CNSS, banque &amp; pointage" Style="{StaticResource EmployeOngletSectionTitle}"/>
                <WrapPanel Margin="0,0,0,8">
                    <Border Style="{StaticResource FicheCard}"><StackPanel><TextBlock Text="N° CNSS" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding NumCnss}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource FicheCard}"><StackPanel><TextBlock Text="Commune d'affectation" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding Commune}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource FicheCard}"><StackPanel><TextBlock Text="Type travailleur CNSS" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding TypeTravailleur}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource FicheCard}"><StackPanel><TextBlock Text="ID terminal ZKTeco" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding ZkUserId}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource FicheCard}"><StackPanel><TextBlock Text="Banque" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding Banque}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource FicheCard}"><StackPanel><TextBlock Text="Compte bancaire" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding Compte}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                </WrapPanel>

                <TextBlock Text="Synthèse RH" Style="{StaticResource EmployeOngletSectionTitle}"/>
                <WrapPanel>
                    <Border Style="{StaticResource FicheCard}" Background="#F0FDF4" BorderBrush="#BBF7D0"><StackPanel><TextBlock Text="Ayants droit" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding NbAyantsDroit}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource FicheCard}" Background="#F0FDF4" BorderBrush="#BBF7D0"><StackPanel><TextBlock Text="Prêts actifs" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding NbPretsActifs}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource FicheCard}" Background="#F0FDF4" BorderBrush="#BBF7D0"><StackPanel><TextBlock Text="Absences / congés" Style="{StaticResource FicheLabel}"/><TextBlock Text="{Binding NbAbsences}" Style="{StaticResource FicheValue}"/></StackPanel></Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
