<UserControl x:Class="MelodyPaieRDC.Views.EmployePretsAvancesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:MelodyPaieRDC.Helpers"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <helpers:StringToIntConverter x:Key="StringToIntConverter"/>
        <helpers:StringToDecimalConverter x:Key="StringToDecimalConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="EtatVide" Background="#F8FAFC" CornerRadius="12" BorderBrush="#A7F3D0" BorderThickness="1"
                Padding="32,28" Margin="0,8,0,0" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" MaxWidth="480">
                <materialDesign:PackIcon Kind="CashMultiple" Width="48" Height="48"
                                         Foreground="{DynamicResource BrandPrimaryBrush}"
                                         HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Sélectionnez un employé pour gérer ses prêts et avances sur salaire."
                           FontSize="14" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContenuPanel" Margin="0,8,0,12" Visibility="Collapsed">
                <Border Style="{StaticResource EmployeOngletPanelCard}" Background="#F0FDF4" BorderBrush="#BBF7D0" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialDesign:PackIcon Kind="CashMultiple" Width="22" Height="22"
                                                     Foreground="{DynamicResource BrandPrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center">
                                <Run Text="Prêts et avances — "/>
                                <Run Text="{Binding NomEmploye, Mode=OneWay}" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="Les échéances sont déduites automatiquement chaque mois sur le bulletin de paie."
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EmployeOngletPanelCard}" Margin="0,0,0,14" IsEnabled="{Binding PeutModifier}">
                    <StackPanel>
                        <TextBlock Text="{Binding TitreFormulaire}" Style="{StaticResource EmployeOngletSectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Montant total" Style="{StaticResource EmployeOngletFieldLabel}"/>
                                <TextBox Text="{Binding MontantTotal, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource StringToDecimalConverter}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Date d'octroi" Style="{StaticResource EmployeOngletFieldLabel}"/>
                                <DatePicker SelectedDate="{Binding DateOctroi, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Début d'échéance *" Style="{StaticResource EmployeOngletFieldLabel}"/>
                                <DatePicker SelectedDate="{Binding DateDebutEcheance, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Nombre d'échéances (mois)" Style="{StaticResource EmployeOngletFieldLabel}"/>
                                <TextBox Text="{Binding NbEcheances, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource StringToIntConverter}}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Command="{Binding EnregistrerCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,8,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Plus"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstEnEdition}" Value="True">
                                                        <Setter Property="Kind" Value="ContentSave"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock Text="{Binding TexteBoutonEnregistrer}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AnnulerEditionCommand}"
                                    Visibility="{Binding EstEnEdition, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8" Margin="8,0,0,0">
                                <TextBlock Text="Annuler"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EmployeOngletPanelCard}" Padding="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Prêts en cours" Style="{StaticResource EmployeOngletSectionTitle}" Margin="16,14,16,10"/>
                        <DataGrid ItemsSource="{Binding PretsAvances}" SelectedItem="{Binding Selectionne, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" Background="Transparent"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                                  RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="36" BorderThickness="0" MaxHeight="320" Margin="8,0,8,8">
                            <DataGrid.ColumnHeaderStyle>
                                <StaticResource ResourceKey="EmployeOngletDataGridHeader"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Montant total" Binding="{Binding MontantTotal, StringFormat=N2}" Width="110"/>
                                <DataGridTextColumn Header="Date octroi" Binding="{Binding DateOctroi, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <DataGridTextColumn Header="Début échéance" Binding="{Binding DateDebutEcheance, StringFormat=dd/MM/yyyy}" Width="110"/>
                                <DataGridTextColumn Header="Échéances" Binding="{Binding NbEcheances}" Width="90"/>
                                <DataGridTextColumn Header="Mensualité" Binding="{Binding MontantMensuel, StringFormat=N2}" Width="100"/>
                                <DataGridTextColumn Header="Solde restant" Binding="{Binding SoldeRestant, StringFormat=N2}" Width="110"/>
                                <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Command="{Binding ModifierCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8" Margin="0,0,8,0"
                            ToolTip="Charge le prêt sélectionné dans le formulaire pour le corriger">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Modifier"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SupprimerCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8"
                            ToolTip="Supprime le prêt sélectionné. Les bulletins déjà générés ne sont pas recalculés.">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Supprimer la sélection"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
