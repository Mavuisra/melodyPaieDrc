<UserControl x:Class="MelodyPaieRDC.Views.EmployeAyantsDroitPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="AyantPanelCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="#F8FAFC" CornerRadius="12" BorderBrush="#A7F3D0" BorderThickness="1"
                Padding="32,28" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,24,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AfficherContenu}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" MaxWidth="480">
                <materialDesign:PackIcon Kind="AccountChildOutline" Width="48" Height="48"
                                         Foreground="{DynamicResource BrandPrimaryBrush}"
                                         HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding MessageVide}" FontSize="14" Foreground="#64748B"
                           TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AfficherContenu}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="0,4,0,12">
                <Border Style="{StaticResource AyantPanelCard}" Padding="16,14" Margin="0,0,0,14"
                        Background="#F0FDF4" BorderBrush="#BBF7D0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialDesign:PackIcon Kind="AccountChild" Width="22" Height="22"
                                                     Foreground="{DynamicResource BrandPrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center">
                                <Run Text="Ayants droit — "/>
                                <Run Text="{Binding TitreEmploye, Mode=OneWay}" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="Les enfants à charge (lien « Enfant ») sont pris en compte pour la réduction d'impôt (IPR) lors du calcul de paie."
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap">
                            <Run Text="Après modification, regénérez les bulletins non clôturés pour appliquer la réduction IPR."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AyantPanelCard}" Padding="16,14" Margin="0,0,0,14"
                        IsEnabled="{Binding PeutModifier}">
                    <StackPanel>
                        <TextBlock Text="Mode lecture seule : vous ne pouvez pas modifier les ayants droit."
                                   FontSize="12" Foreground="#B45309" Margin="0,0,0,10" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PeutModifier}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Nouvel ayant droit" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nom complet" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NouveauNom, UpdateSourceTrigger=PropertyChanged}" MaxLength="255"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Lien de parenté" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding LiensParente}"
                                          SelectedItem="{Binding NouveauLienParente, Mode=TwoWay}"
                                          IsEditable="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Date de naissance (optionnel)" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding NouvelleDateNaissance, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                        <Button Command="{Binding AjouterCommand}" Margin="0,14,0,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Ajouter l'ayant droit"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AyantPanelCard}" Padding="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Liste des ayants droit" FontWeight="SemiBold" FontSize="13"
                                   Foreground="#0F172A" Margin="16,14,16,10"/>
                        <DataGrid ItemsSource="{Binding AyantsDroit}"
                                  SelectedItem="{Binding Selectionne, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F8FAFC"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="36"
                                  BorderThickness="0"
                                  MaxHeight="320"
                                  Margin="8,0,8,8">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F0FDF4"/>
                                    <Setter Property="Foreground" Value="#065F46"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                                <DataGridTextColumn Header="Lien" Binding="{Binding LienParente}" Width="110"/>
                                <DataGridTextColumn Header="Date naissance" Binding="{Binding DateNaissance, StringFormat=dd/MM/yyyy}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Command="{Binding SupprimerCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Supprimer la sélection"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
