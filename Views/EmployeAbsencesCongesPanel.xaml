<UserControl x:Class="MelodyPaieRDC.Views.EmployeAbsencesCongesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent"
             FontFamily="Segoe UI">
    <Grid>
        <Border x:Name="EtatVide" Background="#F8FAFC" CornerRadius="12" BorderBrush="#A7F3D0" BorderThickness="1"
                Padding="32,28" Margin="0,8,0,0" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" MaxWidth="480">
                <materialDesign:PackIcon Kind="CalendarRemoveOutline" Width="48" Height="48"
                                         Foreground="{DynamicResource BrandPrimaryBrush}"
                                         HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Sélectionnez un employé pour gérer ses absences et congés."
                           FontSize="14" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContenuPanel" Margin="0,8,0,12" Visibility="Collapsed">
                <Border Style="{StaticResource EmployeOngletPanelCard}" Background="#F0FDF4" BorderBrush="#BBF7D0" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialDesign:PackIcon Kind="CalendarRemoveOutline" Width="22" Height="22"
                                                     Foreground="{DynamicResource BrandPrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center">
                                <Run Text="Absences et congés — "/>
                                <Run Text="{Binding NomEmploye, Mode=OneWay}" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="Les absences non payées réduisent le salaire ; les congés payés sont pris en compte sans perte de salaire."
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EmployeOngletPanelCard}" Margin="0,0,0,14" IsEnabled="{Binding PeutModifier}">
                    <StackPanel>
                        <TextBlock Text="Nouvelle absence / congé" Style="{StaticResource EmployeOngletSectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Type" Style="{StaticResource EmployeOngletFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding TypesAbsence}" SelectedItem="{Binding Type, Mode=TwoWay}" IsEditable="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Date début" Style="{StaticResource EmployeOngletFieldLabel}"/>
                                <DatePicker SelectedDate="{Binding DateDebut, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Date fin" Style="{StaticResource EmployeOngletFieldLabel}"/>
                                <DatePicker SelectedDate="{Binding DateFin, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                                <CheckBox Content="Rémunérée (congé payé)" IsChecked="{Binding EstPaye, Mode=TwoWay}" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Grid>
                        <Button Command="{Binding AjouterCommand}" Margin="0,14,0,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Ajouter l'absence"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EmployeOngletPanelCard}" Padding="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Historique" Style="{StaticResource EmployeOngletSectionTitle}" Margin="16,14,16,10"/>
                        <DataGrid ItemsSource="{Binding AbsencesConges}" SelectedItem="{Binding Selectionne, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" Background="Transparent"
                                  RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="36" BorderThickness="0" MaxHeight="320" Margin="8,0,8,8">
                            <DataGrid.ColumnHeaderStyle>
                                <StaticResource ResourceKey="EmployeOngletDataGridHeader"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                                <DataGridTextColumn Header="Début" Binding="{Binding DateDebut, StringFormat=dd/MM/yyyy}" Width="110"/>
                                <DataGridTextColumn Header="Fin" Binding="{Binding DateFin, StringFormat=dd/MM/yyyy}" Width="110"/>
                                <DataGridTextColumn Header="Payée" Binding="{Binding EstPaye}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Command="{Binding SupprimerCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Supprimer la sélection"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
