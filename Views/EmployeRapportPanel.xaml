<UserControl x:Class="MelodyPaieRDC.Views.EmployeRapportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:MelodyPaieRDC.Models"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="RapportPanelCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RapportActionButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECFDF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RapportKpiCard" TargetType="Border">
            <Setter Property="Background" Value="#F0FDF4"/>
            <Setter Property="BorderBrush" Value="#BBF7D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,0,8">
            <!-- Filtres -->
            <Border Style="{StaticResource RapportPanelCard}" Padding="16,14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*" MinWidth="220"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Période de paie" FontWeight="SemiBold" FontSize="12" Foreground="#64748B" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding PeriodesPaie}"
                                  SelectedItem="{Binding PeriodeSelectionnee, Mode=TwoWay}"
                                  materialDesign:HintAssist.Hint="Mois / année"
                                  IsEditable="False">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Mois}"/>
                                        <Run Text="/"/>
                                        <Run Text="{Binding Annee}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Employé (focus rapport)" FontWeight="SemiBold" FontSize="12" Foreground="#64748B" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Employes}"
                                  SelectedItem="{Binding EmployeSelectionne, Mode=TwoWay}"
                                  materialDesign:HintAssist.Hint="Matricule / nom — optionnel"
                                  IsEditable="False">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Employe}">
                                    <TextBlock>
                                        <Run Text="{Binding Matricule, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding Nom, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Postnom, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Prenom, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="4"
                            Command="{Binding ActualiserCommand}"
                            Style="{StaticResource RapportActionButton}"
                            VerticalAlignment="Bottom"
                            ToolTip="Recharger périodes et situation paie">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Actualiser" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Message vide -->
            <TextBlock Text="{Binding MessageVide}"
                       Foreground="#78909C"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="24,32">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AfficherSituation}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Situation mensuelle -->
            <Border Padding="16,14" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource RapportPanelCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AfficherSituation}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Situation mensuelle par agent" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="Salaire, quinzaine, retenue, impôt, retards, prêts et solde à payer pour chaque employé de l'entreprise."
                               FontSize="12" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/>

                    <DataGrid ItemsSource="{Binding LignesSituationPaie}"
                              SelectedItem="{Binding LigneSituationSelectionnee, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              RowHeight="36"
                              BorderThickness="0"
                              MaxHeight="360"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F0FDF4"/>
                                <Setter Property="Foreground" Value="#065F46"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="#D1FAE5"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="80"/>
                            <DataGridTextColumn Header="Employé" Binding="{Binding NomComplet}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Salaire" Binding="{Binding SalaireLibelle}" Width="82"/>
                            <DataGridTextColumn Header="Quinzaine" Binding="{Binding QuinzaineLibelle}" Width="82"/>
                            <DataGridTextColumn Header="Retenue" Binding="{Binding RetenueLibelle}" Width="78"/>
                            <DataGridTextColumn Header="Impôt" Binding="{Binding ImpotLibelle}" Width="72"/>
                            <DataGridTextColumn Header="Retards" Binding="{Binding RetardsLibelle}" Width="72"/>
                            <DataGridTextColumn Header="Prêts" Binding="{Binding PretsLibelle}" Width="72"/>
                            <DataGridTextColumn Header="Solde à payer" Binding="{Binding SoldeAPayerLibelle}" Width="96"/>
                            <DataGridTextColumn Header="Statut" Binding="{Binding StatutBulletinLibelle}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Quinzaine = acomptes sur salaire. Retenue = CNSS. Retards = sanctions disciplinaires. Générez les bulletins (menu Calcul) pour remplir les montants."
                               FontSize="11" Foreground="#94A3B8" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Détail employé sélectionné -->
            <Border Padding="16,14" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource RapportPanelCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AfficherDetailEmploye}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,12">
                        <Run Text="Focus : "/>
                        <Run Text="{Binding SituationEmployeSelectionne.NomComplet, Mode=OneWay}"/>
                        <Run Text=" ("/>
                        <Run Text="{Binding SituationEmployeSelectionne.Matricule, Mode=OneWay}"/>
                        <Run Text=") — "/>
                        <Run Text="{Binding PeriodeLibelle, Mode=OneWay}"/>
                    </TextBlock>
                    <WrapPanel>
                        <Border Style="{StaticResource RapportKpiCard}" MinWidth="110">
                            <StackPanel>
                                <TextBlock Text="Salaire" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SituationEmployeSelectionne.SalaireLibelle, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RapportKpiCard}" MinWidth="110">
                            <StackPanel>
                                <TextBlock Text="Quinzaine" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SituationEmployeSelectionne.QuinzaineLibelle, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RapportKpiCard}" MinWidth="110">
                            <StackPanel>
                                <TextBlock Text="Retenue" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SituationEmployeSelectionne.RetenueLibelle, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RapportKpiCard}" MinWidth="110">
                            <StackPanel>
                                <TextBlock Text="Impôt" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SituationEmployeSelectionne.ImpotLibelle, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RapportKpiCard}" MinWidth="110">
                            <StackPanel>
                                <TextBlock Text="Retards" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SituationEmployeSelectionne.RetardsLibelle, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RapportKpiCard}" MinWidth="110">
                            <StackPanel>
                                <TextBlock Text="Prêts" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SituationEmployeSelectionne.PretsLibelle, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RapportKpiCard}" MinWidth="120" Background="#ECFDF5" BorderBrush="#6EE7B7">
                            <StackPanel>
                                <TextBlock Text="Solde à payer" FontSize="11" Foreground="#047857" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SituationEmployeSelectionne.SoldeAPayerLibelle, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#065F46"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Rapports périodiques -->
            <Border Padding="16,14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource RapportPanelCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AfficherSituation}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Rapports périodiques" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="Export PDF pour la période sélectionnée."
                               FontSize="12" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button Command="{Binding ExporterRapportAgentCommand}"
                                Style="{StaticResource RapportActionButton}" Margin="0,0,10,10"
                                ToolTip="PDF situation de l'employé sélectionné">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Rapport agent (PDF)"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExporterRapportQuinzainesCommand}"
                                Style="{StaticResource RapportActionButton}" Margin="0,0,10,10"
                                ToolTip="Rapport des quinzaines / acomptes">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Rapport des quinzaines"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExporterRapportMensuelCommand}"
                                Style="{StaticResource RapportActionButton}" Margin="0,0,0,10"
                                ToolTip="Rapport mensuel complet des salaires">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Rapport mensuel des salaires"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
