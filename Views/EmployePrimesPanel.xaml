<UserControl x:Class="MelodyPaieRDC.Views.EmployePrimesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:MelodyPaieRDC.Helpers"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <helpers:StringToDecimalConverter x:Key="StringToDecimalConverter"/>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="EtatVide" Background="#F8FAFC" CornerRadius="12" BorderBrush="#A7F3D0" BorderThickness="1"
                Padding="32,28" Margin="0,8,0,0" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" MaxWidth="480">
                <materialDesign:PackIcon Kind="GiftOutline" Width="48" Height="48"
                                         Foreground="{DynamicResource BrandPrimaryBrush}"
                                         HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Sélectionnez un employé pour gérer ses primes et indemnités."
                           FontSize="14" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContenuPanel" Margin="0,8,0,12" Visibility="Collapsed">
                <Border Style="{StaticResource EmployeOngletPanelCard}" Background="#F0FDF4" BorderBrush="#BBF7D0" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialDesign:PackIcon Kind="GiftOutline" Width="22" Height="22"
                                                     Foreground="{DynamicResource BrandPrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center">
                                <Run Text="Primes et indemnités — "/>
                                <Run Text="{Binding NomEmploye, Mode=OneWay}" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="Montants mensuels : FIXE ou prorata selon les jours pointés (politique de paie)."
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EmployeOngletPanelCard}" Margin="0,0,0,14" IsEnabled="{Binding PeutModifier}">
                    <StackPanel>
                        <TextBlock Text="Nouvelle affectation" Style="{StaticResource EmployeOngletSectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Prime / indemnité" Style="{StaticResource EmployeOngletFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PrimesDisponibles}" SelectedItem="{Binding PrimeSelectionnee, Mode=TwoWay}"
                                          DisplayMemberPath="Libelle" IsEditable="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Montant mensuel" Style="{StaticResource EmployeOngletFieldLabel}"/>
                                <TextBox Text="{Binding Montant, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource StringToDecimalConverter}}"/>
                            </StackPanel>
                        </Grid>
                        <Button Command="{Binding AjouterCommand}" Margin="0,14,0,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Ajouter"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EmployeOngletPanelCard}" Padding="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Affectations actives" Style="{StaticResource EmployeOngletSectionTitle}" Margin="16,14,16,10"/>
                        <DataGrid ItemsSource="{Binding Affectations}" SelectedItem="{Binding Selectionne, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" Background="Transparent"
                                  RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="36" BorderThickness="0" MaxHeight="320" Margin="8,0,8,8">
                            <DataGrid.ColumnHeaderStyle>
                                <StaticResource ResourceKey="EmployeOngletDataGridHeader"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Prime / indemnité" Binding="{Binding PrimeIndemnite.Libelle}" Width="*"/>
                                <DataGridTextColumn Header="Montant mensuel" Binding="{Binding Montant, StringFormat=N2}" Width="120"/>
                                <DataGridTextColumn Header="Mode calcul" Binding="{Binding PrimeIndemnite.ModeCalcul}" Width="110"/>
                                <DataGridTextColumn Header="Imposable" Binding="{Binding PrimeIndemnite.EstImposable}" Width="90"/>
                                <DataGridTextColumn Header="Cotisable" Binding="{Binding PrimeIndemnite.EstCotisable}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Command="{Binding SupprimerCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="8" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Supprimer la sélection"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
